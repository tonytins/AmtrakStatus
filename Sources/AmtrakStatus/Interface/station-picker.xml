<?xml version="1.0" encoding="UTF-8"?>
<!--
  The station picker, placed under its window's title bar.

  A button named "preset.<CODE>" selects the station with that code. Its text is free to be
  any label, and shows on the board until Amtraker's name for the station loads. Add a button
  to add a preset.

  The "frame" styles color the window around this document. In "frame", fill is the accent
  color and disabled text is the secondary text color.
-->
<UIScript version="1">
  <Window width="760" height="290"/>

  <Style name="frame" textColor="#FFFFFF" disabledTextColor="#A49B8B" backgroundColor="#111417"
         borderColor="#4C443A" fillColor="#EEB148"/>
  <Style name="frameTitle" backgroundColor="#231F1A"/>
  <Style name="frameOverlay" backgroundColor="#0000008C"/>

  <Style name="label" textColor="#A49B8B" fontSize="14"/>
  <Style name="entry" textColor="#FFFFFF" backgroundColor="#000000" borderColor="#4C443A" fontSize="20"/>
  <Style name="button" textColor="#FFFFFF" highlightedTextColor="#EEB148" selectedTextColor="#EEB148"
         backgroundColor="#312E29" borderColor="#4C443A" fontSize="16"/>
  <Style name="problem" textColor="#E86A60" fontSize="14"/>

  <!-- The window's title, drawn by the frame. -->
  <Text name="windowTitle" x="0" y="0" width="0" height="0" text="Change station"/>

  <Text name="codeLabel" x="18" y="14" width="300" height="14" style="label" text="Station code:"/>
  <TextField name="stationCode" x="18" y="34" width="724" height="34" style="entry"
             placeholder="ASD" maximumLength="5"/>
  <Text name="problem" x="18" y="74" width="724" height="14" style="problem"/>

  <Button name="preset.ASD" x="18" y="98" width="233" height="34" style="button" text="Ashland, VA"/>
  <Button name="preset.SNC" x="263" y="98" width="234" height="34" style="button" text="San Juan Capistrano, CA"/>
  <Button name="preset.FMD" x="509" y="98" width="233" height="34" style="button" text="Fort Madison, IA"/>
  <Button name="preset.LAP" x="18" y="144" width="233" height="34" style="button" text="La Plata, MO"/>
  <Button name="preset.QCY" x="263" y="144" width="234" height="34" style="button" text="Quincy, IL"/>
  <Button name="preset.SPB" x="509" y="144" width="233" height="34" style="button" text="Spartanburg, SC"/>

  <Button name="cancel" x="512" y="238" width="110" height="34" style="button" text="Cancel"/>
  <Button name="useCode" x="632" y="238" width="110" height="34" style="button" text="Use code"/>
</UIScript>
